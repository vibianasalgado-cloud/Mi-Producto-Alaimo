# Copia este archivo como .env.local y pídele los valores al dueño del proyecto.
# Usa siempre los de la base de DESARROLLO (sup-mi-producto-dev), nunca los de producción.
# .env.local no se sube a git; este archivo sí, y nunca lleva valores.

# Dirección del proyecto de Supabase. La usan lib/supabase/server.ts, lib/supabase/admin.ts y proxy.ts.
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública de Supabase: con la sesión del usuario consulta la base y se aplica el RLS. La usan lib/supabase/server.ts y proxy.ts.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta de Supabase: salta el RLS. Solo la usa el panel admin (lib/supabase/admin.ts). No la compartas ni le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Correos que pueden entrar a /admin, separados por coma. La usa lib/admin.ts.
ADMIN_EMAILS=
